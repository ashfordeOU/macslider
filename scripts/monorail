#!/bin/sh
# Command-line control for Monorail by Ashforde®.
#   monorail <action>                 run any action (focus-left, overview, …)
#   monorail layout|pair|template|snapshot <name>
#   monorail windows|state|workspaces|layouts|pairs|templates|snapshots|actions
# Queries need the local API (Settings → Automation → Local API) and print JSON.
set -eu

usage() {
    cat <<'USAGE'
Usage: monorail <action>
       monorail layout|pair|template|snapshot <name>
       monorail windows|state|workspaces|layouts|pairs|templates|snapshots|actions

Actions include:
  focus-left focus-right focus-up focus-down focus-first focus-last
  move-left move-right cycle-width full-width center cycle-layout regroup
  workspace-1 … workspace-9 move-to-workspace-1 … next-workspace
  overview command-palette hints focus-mode solo show-desktop undo redo
  `monorail actions` lists them all (with the local API on).
USAGE
}

api() {
    dir="$HOME/Library/Application Support/Monorail"
    if [ ! -f "$dir/api-port" ]; then
        echo "monorail: turn on the local API in Monorail ▸ Settings ▸ Automation" >&2
        exit 69
    fi
    curl -fsS -H "Authorization: Bearer $(cat "$dir/api-token")" "http://127.0.0.1:$(cat "$dir/api-port")/$1"
    echo
}

encode() { printf '%s' "$1" | sed -e 's/%/%25/g' -e 's/ /%20/g' -e 's/+/%2B/g' -e 's/&/%26/g' -e 's/#/%23/g' -e 's/?/%3F/g'; }

if [ $# -eq 0 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    [ $# -eq 1 ] && exit 0
    exit 64
fi

case "$1" in
    windows|state|workspaces|layouts|pairs|templates|snapshots|actions)
        api "$1" ;;
    layout|pair|template|snapshot)
        [ $# -eq 2 ] || { usage; exit 64; }
        exec open -g "monorail://$1/$(encode "$2")" ;;
    *[!a-z0-9-]*)
        echo "monorail: invalid action: $1" >&2; exit 64 ;;
    *)
        exec open -g "monorail://$1" ;;
esac
