#!/bin/sh
# Command-line control for MacSlider: `macslider <action>`.
# Runs the action through the macslider:// URL scheme without stealing focus.
set -eu

usage() {
    cat <<'USAGE'
Usage: macslider <action>

Focus:    focus-left focus-right focus-up focus-down focus-first focus-last
          focus-column-1 … focus-column-9
Move:     move-left move-right move-up move-down send-to-next-display
Size:     cycle-width cycle-width-backward narrower wider full-width center
          toggle-fullscreen
Slides:   regroup cycle-layout main-larger main-smaller make-main
          stack-into-left stack-into-right unstack-left unstack
          toggle-tabbed pin-left pin-right toggle-float
Spaces:   workspace-1 … workspace-9 move-to-workspace-1 … move-to-workspace-9
View:     overview window-switcher
App:      toggle-pause retile settings welcome
USAGE
}

if [ $# -ne 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    usage
    [ $# -eq 1 ] && exit 0
    exit 64
fi

case "$1" in
    *[!a-z0-9-]*) echo "macslider: invalid action: $1" >&2; exit 64 ;;
esac

exec open -g "macslider://$1"
